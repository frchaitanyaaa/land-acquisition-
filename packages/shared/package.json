{
  "name": "@bhoomisetu/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Enums, redaction map, canonical JSON — shared by api, portal, field and packages.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
