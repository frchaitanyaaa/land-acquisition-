{
  "name": "bhoomisetu",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:db": "turbo run test:db",
    "test:e2e:api": "pnpm --filter @bhoomisetu/api test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "infra:up": "docker compose up -d --build --wait",
    "infra:down": "docker compose down",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "db:reset": "turbo run db:reset",
    "rules:check": "turbo run rules:check",
    "chain:node": "pnpm --filter @bhoomisetu/chain run node",
    "chain:deploy": "pnpm --filter @bhoomisetu/chain run deploy",
    "test:contracts": "pnpm --filter @bhoomisetu/chain test:contracts",
    "demo:tamper": "pnpm --filter @bhoomisetu/db demo:tamper",
    "demo:tunnel": "node scripts/demo-tunnel.mjs",
    "demo:reset": "pnpm db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "argon2",
      "esbuild",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}
